name: Scrape and publish

on:
  schedule:
    - cron: "*/15 * * * *"     # quick: firm job boards + GitHub lists, with phone alerts
    - cron: "17 */6 * * *"     # full: + LinkedIn + careers pages, closes vanished postings
  workflow_dispatch:
    inputs:
      mode:
        description: "quick or full"
        default: "full"
  push:
    branches: [main]
    paths: ["*.py", ".github/workflows/scrape.yml"]

permissions:
  contents: write

concurrency:
  group: scrape
  cancel-in-progress: false

jobs:
  scrape:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - run: pip install -r requirements.txt

      - name: Scrape
        env:
          NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
          NTFY_SERVER: ${{ secrets.NTFY_SERVER }}
          SITE_URL: https://${{ github.repository_owner }}.github.io/${{ github.event.repository.name }}/
        run: |
          if [ "${{ github.event.schedule }}" = "*/15 * * * *" ] || [ "${{ github.event.inputs.mode }}" = "quick" ]; then
            python scraper.py --quick --alert -v
          else
            python scraper.py --alert -v
          fi

      - name: Commit updated data
        run: |
          git config user.name "career-radar-bot"
          git config user.email "actions@users.noreply.github.com"
          git add jobs.db docs/jobs.json boards_auto.json
          if git diff --cached --quiet; then
            echo "No changes."
          else
            git commit -m "data: refresh listings $(date -u +'%Y-%m-%d %H:%M UTC')"
            git pull --rebase origin main || true
            git push
          fi
